# Backend environment variables
# Copy to .env and fill in values. Never commit secrets.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
APP_NAME=Graphology Platform
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://graphology:graphology@localhost:5432/graphology?schema=public
DIRECT_URL=postgresql://graphology:graphology@localhost:5432/graphology?schema=public

# JWT (placeholders until authentication is implemented)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (placeholders until payments are implemented)
RAZORPAY_KEY_ID=rzp_placeholder
RAZORPAY_SECRET=rzp_secret_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Resend (placeholders until email is implemented)
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=noreply@example.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
