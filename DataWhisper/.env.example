JWT_SECRET=replace-with-long-random-secret-min-32-chars
NEXTAUTH_SECRET=replace-with-long-random-secret-min-32-chars

# LLM: set Gemini (Google AI Studio) and/or OpenAI. AI_PROVIDER=auto prefers Gemini if GEMINI_API_KEY is set.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

ENCRYPTION_KEY=

# Database: superuser for migrations, non-superuser (app role) for runtime so RLS is enforced
MIGRATION_DATABASE_URL=postgresql://datawhisper:datawhisper_secret@postgres:5432/datawhisper
DATABASE_URL=postgresql://datawhisper_app:datawhisper_app_secret@postgres:5432/datawhisper

# Cron secret for /internal/cron endpoints
CRON_SECRET=

# SMTP for scheduled report emails (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
