# Set in Vercel project settings → Environment Variables (Production)

NEXTAUTH_URL=https://datawhisper.zaavero.com
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32

# Must include https:// — Vercel strips nothing, but omitting the scheme breaks browser fetch
NEXT_PUBLIC_API_URL=https://datawhisper-api.onrender.com
INTERNAL_API_URL=https://datawhisper-api.onrender.com
