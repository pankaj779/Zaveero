# Production — set in Render dashboard (never commit real values)

DATABASE_URL=postgresql://USER:PASS@HOST.neon.tech/zaavero?sslmode=require
JWT_SECRET=generate-with-openssl-rand-hex-32
CORS_ORIGINS=https://zaavero.com,https://www.zaavero.com

AGENTOPS_LAUNCH_URL=https://agentops.zaavero.com/sso/zaavero
