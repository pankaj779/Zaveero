DATABASE_URL="file:./prisma/dev.db"
NEXTAUTH_SECRET="change-me-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Owner admin login
ADMIN_EMAIL="prajapathipankaj321@gmail.com"
ADMIN_PASSWORD="change-me"

# All owner alerts (contact, quote, review) go here
CONTACT_EMAIL_TO="prajapathipankaj321@gmail.com"

# Option 1: Gmail SMTP (recommended)
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an App Password for "Mail"
# 3. Paste the 16-character password below (not your regular Gmail password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="prajapathipankaj321@gmail.com"
SMTP_PASS="your-gmail-app-password-here"

# Option 2: Resend (https://resend.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# WhatsApp alerts via CallMeBot (free for personal use)
# 1. Save +34 644 44 71 67 in WhatsApp contacts as "CallMeBot"
# 2. Send this exact message to CallMeBot: I allow callmebot to send me messages
# 3. CallMeBot replies with your API key — paste it below
# 4. Set your phone with country code, no + sign (e.g. 919900984570 for India)
WHATSAPP_NOTIFY_PHONE="919900984570"
WHATSAPP_API_KEY="your-callmebot-api-key"

# Cloudinary (production uploads — https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
