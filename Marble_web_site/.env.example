# Copy to .env for local dev. Set the same keys in Vercel (Production).

DATABASE_URL="file:./prisma/dev.db"

NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

CONTACT_EMAIL_TO="you@example.com"

# Gmail SMTP (or use Resend below)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Optional: Resend instead of SMTP
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Optional: WhatsApp alerts (CallMeBot)
WHATSAPP_NOTIFY_PHONE=""
WHATSAPP_API_KEY=""

# Production (Phase 2): Neon Postgres
# DATABASE_URL="postgresql://...?sslmode=require"

# Production (Phase 2): Cloudinary uploads
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
