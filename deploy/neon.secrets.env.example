# Step 2 — Neon PostgreSQL (free tier)
#
# Copy this file to neon.secrets.env and fill in real values.
# NEVER commit neon.secrets.env — it is gitignored.

# Zaavero platform database (for Render service: zaavero-api)
ZAAVERO_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/zaavero?sslmode=require

# DataWhisper database (for Render service: datawhisper-api)
DATAWHISPER_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/datawhisper?sslmode=require

# Sanjana Stone Arts (Marble_web_site on Vercel)
SANJANA_STONE_ARTS_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/sanjana_stone_arts?sslmode=require

# JWT secrets for Render (run: .\scripts\generate-jwt-secret.ps1 three times)
ZAAVERO_JWT_SECRET=
AGENTOPS_JWT_SECRET=
DATAWHISPER_JWT_SECRET=
