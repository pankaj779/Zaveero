# Production — set in Render dashboard

DATABASE_URL=postgresql://USER:PASS@HOST.neon.tech/datawhisper?sslmode=require
MIGRATION_DATABASE_URL=postgresql://USER:PASS@HOST.neon.tech/datawhisper?sslmode=require
JWT_SECRET=generate-with-openssl-rand-hex-32
ZAAVERO_API_URL=https://api.zaavero.com
CORS_ORIGINS=https://datawhisper.zaavero.com

# Neon free tier: use single DB role — skip RLS role bootstrap
SKIP_RLS_SETUP=1

